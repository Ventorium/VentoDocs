# 复制为 .env 并按需修改
VIENTO_DATA_DIR=./data
VIENTO_DB_URL=postgres://vento:vento@127.0.0.1:5432/vento
VIENTO_REDIS_URL=redis://127.0.0.1:6379
VIENTO_JWT_SECRET=change-me-please-use-a-long-random-string
VIENTO_JWT_TTL_HOURS=24
VIENTO_MAX_UPLOAD_MB=500
VIENTO_TRASH_RETENTION_DAYS=180
VIENTO_VERSION_KEEP=20
VIENTO_AUDIT_RETENTION_DAYS=365
# 后台维护间隔（分钟）：回收站过期清理 / 版本裁剪 / 孤儿对象 GC / 审计保留；
# 0 = 完全关闭（需自行运维磁盘）。启动后立即跑一轮，之后按间隔循环。
VIENTO_JANITOR_INTERVAL_MINUTES=360
# 目录网站发布泛域名后缀（如 publish.example.com）；留空=禁用发布
VIENTO_PUBLISH_DOMAIN=
VIENTO_BIND_ADDR=0.0.0.0:8080
# 跨域来源白名单（逗号分隔）。默认留空 = 不放开跨域（推荐，SPA 与 API 同源）。
# 仅当把前端单独部署在其它源时才需要填，例如：https://docs.example.com
# VIENTO_CORS_ORIGINS=
# 是否信任反向代理传来的 X-Forwarded-For / X-Real-IP。
# 默认 false（直连部署，转发头可被客户端伪造：会污染审计 IP 并绕过按 IP 限流）。
# 只有在本服务前挂了可信反代（Nginx/Traefik 等）时才设为 true。
# VIENTO_TRUST_PROXY=false
# 在线编辑器静态资源目录（相对进程 CWD）；缺 index.html 时编辑功能自动禁用
# VENTO_EDITOR_DIST=editor-dist
# LDAP 目录导入（§15/§16/§17）：VIENTO_LDAP_HOST 留空 = 功能未启用。
# 绑定凭据只从环境变量读取，不落库。
# VIENTO_LDAP_HOST=ldap.example.com
# VIENTO_LDAP_PORT=389
# VIENTO_LDAP_START_TLS=false
# VIENTO_LDAP_BASE_DN=ou=people,dc=example,dc=com
# VIENTO_LDAP_BIND_DN=cn=readonly,dc=example,dc=com
# VIENTO_LDAP_BIND_PASSWORD=
# VIENTO_LDAP_USER_FILTER=(objectClass=inetOrgPerson)
# VIENTO_LDAP_ATTR_USERNAME=uid
# VIENTO_LDAP_ATTR_NAME=cn
# VIENTO_LDAP_ATTR_EMAIL=mail
# v2 预留（当前不启用）
# VIENTO_LLM_BASE_URL=
# VIENTO_LLM_API_KEY=
# VIENTO_LLM_MODEL=
